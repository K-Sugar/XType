#!/usr/bin/env python3
"""xtype-watch — tail and filter the fcitx5 engine debug logs.

Usage:
    xtype-watch
    xtype-watch --tag corpus
    xtype-watch --tag corpus,profile,prompt,harvest
    xtype-watch --debug-log path/to/debug.log --thread-log path/to/thread.log

Both log files are truncated each time fcitx5 reloads the addon, so this
helper handles the file shrinking back to zero gracefully (re-opens on
detection).
"""
import argparse
import os
import sys
import time
from pathlib import Path

DEFAULT_DEBUG_LOG  = Path("/home/saint/Desktop/XType/fcitx5-engine/debug.log")
DEFAULT_THREAD_LOG = Path("/home/saint/Desktop/XType/fcitx5-engine/thread.log")
TAGS_DEFAULT = ("corpus", "profile", "prompt", "harvest", "debug")


class FileTail:
    def __init__(self, path: Path, label: str):
        self.path  = path
        self.label = label
        self.fp    = None
        self.pos   = 0

    def _open(self):
        try:
            self.fp = open(self.path, "r", encoding="utf-8", errors="replace")
            self.fp.seek(0, os.SEEK_END)
            self.pos = self.fp.tell()
        except FileNotFoundError:
            self.fp = None

    def read_new(self):
        if self.fp is None:
            self._open()
            if self.fp is None:
                return []
        try:
            stat = os.stat(self.path)
        except FileNotFoundError:
            self.fp.close()
            self.fp = None
            return []

        if stat.st_size < self.pos:
            # File was truncated (engine reloaded). Re-open from start.
            self.fp.close()
            self.fp = open(self.path, "r", encoding="utf-8", errors="replace")
            self.pos = 0

        self.fp.seek(self.pos)
        data = self.fp.read()
        self.pos = self.fp.tell()
        if not data:
            return []
        return data.splitlines()


def matches_tag(line: str, tags) -> bool:
    if not tags:
        return True
    for t in tags:
        if f"[{t}]" in line:
            return True
    return False


def main():
    p = argparse.ArgumentParser(prog="xtype-watch", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--tag", default="",
                   help=f"Comma-separated tag filter; default shows all. "
                        f"Known tags: {','.join(TAGS_DEFAULT)}")
    p.add_argument("--debug-log",  default=str(DEFAULT_DEBUG_LOG),
                   help=f"Path to engine debug log (default: {DEFAULT_DEBUG_LOG})")
    p.add_argument("--thread-log", default=str(DEFAULT_THREAD_LOG),
                   help=f"Path to inference thread log (default: {DEFAULT_THREAD_LOG})")
    p.add_argument("--no-thread-log", action="store_true",
                   help="Skip the thread log; only watch debug log")
    args = p.parse_args()

    tags = [t.strip() for t in args.tag.split(",") if t.strip()]
    if tags:
        print(f"# filter: tags={tags}", flush=True)
    else:
        print("# filter: (none — all lines)", flush=True)

    tails = [FileTail(Path(args.debug_log),  "dbg")]
    if not args.no_thread_log:
        tails.append(FileTail(Path(args.thread_log), "inf"))

    try:
        while True:
            for tail in tails:
                for line in tail.read_new():
                    if matches_tag(line, tags):
                        print(f"[{tail.label}] {line}", flush=True)
            time.sleep(0.2)
    except KeyboardInterrupt:
        print("\n# stopped", flush=True)
        return 0


if __name__ == "__main__":
    sys.exit(main())
